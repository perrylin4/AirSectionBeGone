{
  "schemaVersion": 1,
  "id": "airbegone",
  "provides": ["airsectionbegone"],
  "version": "${version}",
  "name": "AirBeGone",
  "description": "Shares uniform chunk-section containers and identical heightmaps, and sparsely caches POI sections to reduce dedicated-server memory usage.",
  "authors": [
    "perrylin4"
  ],
  "contact": {
    "sources": "https://github.com/perrylin4/AirBeGone",
    "issues": "https://github.com/perrylin4/AirBeGone/issues"
  },
  "license": "MIT",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.perry.asbg.AirBeGone"
    ]
  },
  "mixins": [
    "airbegone.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "=1.21.11",
    "java": ">=21",
    "fabric-api": ">=0.141.6+1.21.11",
    "lithium": "=0.21.4"
  },
  "suggests": {
    "c2me": "*",
    "fantasy": "*",
    "ferritecore": "*"
  }
}
